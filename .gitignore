# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# Environment variables and secrets (NEVER COMMIT REAL CREDENTIALS)
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# SQLite Database and runtime storage
*.db
*.sqlite
*.sqlite3
email_automation.db

# Logs (keep .gitkeep and sample log only)
logs/*.log
logs/*.lock
!logs/.gitkeep
!logs/sample_sanitized.log

# Reports and temporary exports
outputs/*.csv
!outputs/.gitkeep
!outputs/sample_reports/

# Frontend dependencies and builds
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
.eslintcache

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Migration utility (one-time use, not part of the application)
migrate_db.py
