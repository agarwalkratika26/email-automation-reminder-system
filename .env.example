# ==============================================================================
# Email Automation & Reminder System — Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' before running the application.
# - DO NOT commit your actual '.env' file or real credentials to Git.
# - By default, DRY_RUN=true, which ensures emails are simulated and NO network
#   or SMTP connections are attempted.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# SQLite Database Location
DATABASE_URL=sqlite:///./email_automation.db

# Delivery Mode:
# 'true'  = Simulation Mode (Default & Safe): Emails are logged and marked as 'simulated'.
# 'false' = Live SMTP Delivery: Requires valid SMTP settings below.
DRY_RUN=true

# ==============================================================================
# SMTP Modes (Only active when DRY_RUN=false)
# ==============================================================================
# Mode A: Authenticated SMTP (Default for Gmail, Outlook, SendGrid, Amazon SES)
#   SMTP_AUTH_REQUIRED=true
#   Requires valid SMTP_USERNAME and SMTP_PASSWORD.
#
# Mode B: Unauthenticated Local Relay (Internal Docker, MailHog, Postfix)
#   SMTP_AUTH_REQUIRED=false
#   Username and password are not sent to the mail host.
# ==============================================================================
SMTP_AUTH_REQUIRED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_username@example.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Campaign Automation System"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Worker / Scheduler Configuration
WORKER_POLL_INTERVAL_SECONDS=5
BATCH_SEND_SIZE=10
STALE_JOB_TIMEOUT_SECONDS=300
